<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network for weather API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Broadcast permission for MCU head unit event service -->
    <uses-permission android:name="com.szchoiceway.permission.broadcast" />

    <!-- GPS for telemetry and weather location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required for LocationManager.sendExtraCommand (A-GPS reset) — normal protection, auto-granted -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />

    <!-- Compass / sensors -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- Media session control (requires notification access grant by user) -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />

    <!-- Wallpaper from gallery -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Query all packages required on API 30+ for getInstalledApplications -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Confirmed on-device: even with OpenLauncher correctly set as the
         default home app, the OEM launcher still wins actual cold-boot
         foreground — it very likely self-launches from its own
         BOOT_COMPLETED receiver, a mechanism that isn't gated by "who's
         the default home app" at all. This gives OpenLauncher the same
         self-assertion to compete on equal footing. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Edge-swipe volume gesture + in-launcher Equalizer -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Required on API 30+ so PackageManager returns ALL launcher apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Open Launcher"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:exported="true">

        <!-- Single launcher activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustNothing">

            <!-- HOME launcher intent filters -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fires MainActivity right after boot, singleTask so this brings
             an existing instance forward rather than duplicating it. Best
             effort — Android 10+ background-activity-start restrictions
             mean this isn't guaranteed to win the race against the OEM
             launcher's own boot receiver, only gives us the same shot it
             already has. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Notification listener service for MediaSession / Now Playing -->
        <service
            android:name=".service.MediaListenerService"
            android:exported="true"
            android:label="Open Launcher Media"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
