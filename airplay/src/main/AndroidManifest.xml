<?xml version="1.0" encoding="utf-8"?>
<!-- Built-in AirPlay. The receiver and its screen run in their own process (":airplay"),
     so a crash in the third-party code never takes the launcher down. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <service
            android:name="io.github.jqssun.airplay.service.AirPlayService"
            android:process=":airplay"
            android:foregroundServiceType="connectedDevice|mediaPlayback"
            android:exported="false" />

        <activity
            android:name="io.github.jqssun.airplay.mmi.MirrorActivity"
            android:process=":airplay"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
